# Copy to .env and set real values. Every variable has a development default in
# docker-compose.yml, so the stack also starts without this file — but those defaults
# are public, so never use them for anything reachable from the internet.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL (one database per service)
INCIDENT_DB_USER=incidentalertuser
INCIDENT_DB_PASSWORD=change-me
MANAGEMENT_DB_USER=incidentalertmanager
MANAGEMENT_DB_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=incidentalert
RABBITMQ_PASSWORD=change-me

# JWT signing key shared by Management, ML and Statistics (at least 32 bytes).
# Generate one with: openssl rand -base64 48
# In Production the services refuse to start with the development key.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Google sign-in (optional). The API verifies Google ID tokens for this client ID
# and only accepts verified addresses of the allowed domain.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=student.etf.unibl.org

# Origins allowed by CORS
USER_FRONTEND_URL=http://localhost:3000
MANAGEMENT_FRONTEND_URL=http://localhost:3001
